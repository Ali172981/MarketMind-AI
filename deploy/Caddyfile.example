# Replace api.example.com with a domain whose DNS A/AAAA records point to your VPS.
# Caddy obtains and renews free HTTPS certificates automatically.
api.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}
